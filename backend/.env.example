# Server-only values. Do not commit a populated .env file or expose these through Angular runtime config.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=5000
APP_ORIGINS=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Required before production deployment. Persistence is not implemented yet.
DATABASE_URL=

# Set only while creating the first administrator, then remove/rotate it.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# Optional Google OAuth for client portal login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_PORTAL_REDIRECT_URL=http://localhost:3000/portal
