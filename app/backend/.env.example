# Server only. Never copy these values to the frontend or commit real credentials.
NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/skja
SESSION_SECRET=replace-with-a-long-random-secret-from-a-secret-manager
EMAIL_PROVIDER_API_KEY=replace-in-secret-manager
OBJECT_STORAGE_BUCKET=skja-private
OBJECT_STORAGE_REGION=replace-me
AUDIT_LOG_RETENTION_DAYS=365
